# .gitignore


# junk
.DS_Store
*~

# Secrets
*.token
.env

# Model weights
*.pt
*.bin
*.safetensors

# Generated Outputs
__pycache__/
.ipynb_checkpoints/
*.pyc

# result files
*.npz
*.pdf

data/*
!data/.gitkeep

figures/workflows/*
!figures/workflows/.gitkeep

figures/notebooks/*
!figures/notebooks/.gitkeep


# extras
old/
code_design_prompts/
claude_staging_area/
tests/
sandbox/
figures/extras/
.claude/
